# Production Environment Configuration
NODE_ENV=production

# Server Port (default 3001, or 8080/container port)
PORT=3001

# Production Log Level
LOG_LEVEL=info

# Production Database (Replace with your managed PostgreSQL URI)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Set to true for cloud providers requiring SSL/TLS (AWS RDS, Neon, Supabase, Render, Railway)
DATABASE_SSL=true

# Database pool capacity
DATABASE_MAX_CONNECTIONS=10

# Docker Compose PostgreSQL credentials
POSTGRES_USER=connect_sphere
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=connect_sphere

# Optional CORS whitelist if frontend is hosted on separate domain/CDN
# CORS_ORIGIN=https://app.connectsphere.com

# Trust reverse proxy headers (1 = single proxy e.g. Nginx, ALB, Cloudflare)
TRUST_PROXY=1

# WebRTC STUN & TURN Infrastructure for Carrier-Grade NAT & Firewall Traversal
# Comma-separated list of STUN servers for peer reflexive candidate discovery
WEBRTC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Managed Turnix relay credentials (keep this token server-side)
TURNIX_API_TOKEN=

# TURN relay (required for clients behind restrictive NAT/mobile carrier networks)
# With Docker Compose Coturn, use your server's public DNS name and random shared secret.
# TURN_URL=turn:turn.connectsphere.com:3478?transport=udp,turn:turn.connectsphere.com:3478?transport=tcp
# TURN_EXTERNAL_IP=203.0.113.10
# TURN_SHARED_SECRET=replace_with_a_long_random_secret
# TURN_REALM=connectsphere
# Open TURN_PORT (default 3478) and UDP/TCP relay ports 49160-49200 on the host firewall.

# Cloudflare R2 private chat attachment storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Background Web Push Notifications (generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@connectsphere.com

# Phone OTP delivery (required for phone sign-in)
SMS_HORIZON_TOKEN=
SMS_HORIZON_USER=
SMS_HORIZON_SENDER_ID=
SMS_HORIZON_TID=

# Password-reset email delivery (required for email password resets)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ConnectSphere

